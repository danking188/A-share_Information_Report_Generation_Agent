# LLM provider: dashscope | openai_compatible
LLM_PROVIDER=dashscope
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=qwen-max
# OpenAI-compatible providers should set, for example: https://host.example/v1
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=5

# Backward-compatible DashScope key; LLM_API_KEY takes precedence.
DASHSCOPE_API_KEY=

# Market-data provider: akshare | http_json
MARKET_DATA_PROVIDER=akshare
# For http_json, configure a normalized company or third-party API.
MARKET_DATA_BASE_URL=
MARKET_DATA_API_KEY=
MARKET_DATA_COMPREHENSIVE_PATH=/stocks/{symbol}/comprehensive
MARKET_DATA_NAME_PATH=/stocks/{symbol}/name
MARKET_DATA_TIMEOUT_SECONDS=20
MARKET_DATA_MAX_RETRIES=2

# Optional report and logging defaults
REPORT_AUTHOR=
REPORT_LANGUAGE=zh-CN
LOG_LEVEL=INFO
REPORT_BODY_FONT=
REPORT_HEADING_FONT=
